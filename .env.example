# ── Web demo (browser) — Google Calendar via Google Identity Services ─────────
# These VITE_ vars are bundled into the frontend (the client ID is NOT a secret
# in the browser OAuth token flow; no client secret is used here).
# Copy this file to ".env" and fill in your values, then restart `npm run dev`.
# ── Web build → HTTP API server ───────────────────────────────────────────────
# URL of the server (`cargo run --bin server`). Set this and the web talks to the
# real backend; leave empty for the standalone localStorage demo. Desktop (Tauri)
# ignores it and uses the embedded backend.
VITE_API_URL=http://localhost:8787

# ── Server CORS (production) ──────────────────────────────────────────────────
# Comma-separated exact web origins allowed to call the API. Leave empty in dev
# (= allow any). In production set to your deployed web URL, e.g.
#   ALLOWED_ORIGINS=https://crm-trungtam.vercel.app
ALLOWED_ORIGINS=

# OAuth client ID từ Google Cloud Console (dạng ...apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=
# Calendar ID muốn hiển thị (dạng ...@group.calendar.google.com hoặc "primary")
VITE_GOOGLE_CALENDAR_ID=

# ── Desktop (Tauri) Google Calendar — Service Account (shared calendar) ───────
# The backend pushes sessions to one shared calendar so everyone can view it on
# their phones. See docs/google-calendar-service-account.md. Never commit the key.
GOOGLE_SERVICE_ACCOUNT_FILE=./google-sa.json
GOOGLE_CALENDAR_ID=

# ── (Legacy) Browser OAuth — only used by the hosted web demo, not desktop ────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Turso (libSQL) — hosted primary; each machine keeps a local replica file ──
# Backend-only. In production these move to the OS keychain (never commit .env).
# Database URL, dạng libsql://<db-name>-<org>.turso.io
TURSO_DATABASE_URL=
# Auth token (turso db tokens create <db>) — chuỗi dài bắt đầu bằng "ey..."
TURSO_AUTH_TOKEN=
# Tên file replica local (tương đối trong app-data dir). Để mặc định là được.
TURSO_REPLICA_FILE=crm.db

# ── Cloudflare R2 (hoặc S3) — lưu file chứng từ dùng chung giữa các máy ────────
# Backend-only. Never commit real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=crm-payment-docs
# Endpoint S3 của R2, dạng https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
