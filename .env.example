# ── Web demo (browser) — Google Calendar via Google Identity Services ─────────
# These VITE_ vars are bundled into the frontend (the client ID is NOT a secret
# in the browser OAuth token flow; no client secret is used here).
# Copy this file to ".env" and fill in your values, then restart `npm run dev`.
VITE_GOOGLE_CLIENT_ID=110763770662-bjl2divn3h5u4tqopl6ngfpfmeqr5pum.apps.googleusercontent.com
VITE_GOOGLE_CALENDAR_ID=131aa743e667279a658960672bdc17aa71f31d8cde87b02b878c5989948e6678@group.calendar.google.com

# ── Production desktop (Tauri) — server-side OAuth, stored in OS keychain ──────
# Used only by the Rust/Tauri backend, never exposed to the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=
